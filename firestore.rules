rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isUser(userId) {
      return signedIn() && uid() == userId;
    }

    function isPostOwner() {
      return signedIn() && resource.data.ownerId == uid();
    }

    function keepsOwnerId() {
      return request.resource.data.ownerId == resource.data.ownerId;
    }

    function isChatParticipant(data) {
      return signedIn() && (
        data.ownerId == uid()
        || data.reporterId == uid()
        || (data.participantIds is list && uid() in data.participantIds)
      );
    }

    function keepsChatParticipants() {
      return request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.reporterId == resource.data.reporterId
        && request.resource.data.participantIds == resource.data.participantIds;
    }

    function validParticipantIds(data) {
      return data.participantIds is list
        && data.ownerId != data.reporterId
        && data.participantIds.size() == 2
        && data.participantIds.hasAll([data.ownerId, data.reporterId]);
    }

    function hasNoPublicContactFields(data) {
      return !data.keys().hasAny([
        'isContactRevealedToAll',
        'ownerPhone',
        'ownerEmail',
        'ownerAddress',
        'ownerLatitude',
        'ownerLongitude',
        'latitude',
        'longitude'
      ]);
    }

    function publicContactFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isContactRevealedToAll',
        'ownerPhone',
        'ownerEmail',
        'ownerAddress',
        'ownerLatitude',
        'ownerLongitude',
        'latitude',
        'longitude'
      ]);
    }

    function hasNoChatContactFields(data) {
      return !data.keys().hasAny([
        'isContactSharedByOwner',
        'contactGrantId',
        'contactGrantIds',
        'ownerPhone',
        'ownerEmail',
        'ownerAddress',
        'phone',
        'email',
        'address'
      ]);
    }

    function chatContactFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isContactSharedByOwner',
        'contactGrantId',
        'contactGrantIds',
        'ownerPhone',
        'ownerEmail',
        'ownerAddress',
        'phone',
        'email',
        'address'
      ]);
    }

    function validCloudinaryMediaReference(data) {
      return data.photoUri is string
        && data.photoUri.matches('https://res.cloudinary.com/.*')
        && data.mediaProvider == 'CLOUDINARY'
        && data.mediaPublicId is string
        && data.mediaPublicId.size() > 0
        && data.mediaContentType is string
        && data.mediaContentType.matches('image/.*')
        && data.mediaSource in ['CAMERA', 'GALLERY', ''];
    }

    function validOptionalMediaReference(data) {
      return (
          data.photoUri == ''
          && data.mediaProvider == ''
          && data.mediaPublicId == ''
          && data.mediaContentType == ''
          && data.mediaSource == ''
        )
        || validCloudinaryMediaReference(data);
    }

    function validLocationSource(data) {
      return data.locationSource in ['DEVICE_GPS', 'MANUAL_COARSE', 'NONE', ''];
    }

    function preciseSightingLocationIsConsented(data) {
      return data.locationSource != 'DEVICE_GPS'
        || (
          data.preciseLocationConsented == true
          && data.latitude is number
          && data.longitude is number
        );
    }

    function hasNoSensitiveNotificationFields(data) {
      return !data.keys().hasAny([
        'ownerPhone',
        'ownerEmail',
        'ownerAddress',
        'phone',
        'email',
        'address',
        'latitude',
        'longitude',
        'coordinates',
        'contactValue'
      ]);
    }

    function chatAfter(chatId) {
      return getAfter(/databases/$(database)/documents/chatSessions/$(chatId)).data;
    }

    function validMessageCreate(chatId, messageId) {
      return isChatParticipant(chatAfter(chatId))
        && request.resource.data.id == messageId
        && request.resource.data.chatId == chatId
        && request.resource.data.senderId == uid()
        && request.resource.data.senderId in chatAfter(chatId).participantIds;
    }

    match /users/{userId} {
      allow create: if isUser(userId) && request.resource.data.uid == userId;
      allow read, delete: if isUser(userId);
      allow update: if isUser(userId)
        && request.resource.data.uid == userId
        && resource.data.uid == userId;

      match /notifications/{notificationId} {
        allow read: if isUser(userId);
        allow create: if signedIn()
          && request.resource.data.recipientId == userId
          && request.resource.data.title is string
          && request.resource.data.message is string
          && request.resource.data.type in ['ALERT', 'CHAT']
          && request.resource.data.targetId is string
          && request.resource.data.isRead == false
          && hasNoSensitiveNotificationFields(request.resource.data);
        allow update: if isUser(userId)
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
        allow delete: if isUser(userId);
      }
    }

    match /petPosts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.id == postId
        && request.resource.data.petName is string
        && request.resource.data.status in ['PERDIDO', 'AVISTADO', 'REUNIDO']
        && validCloudinaryMediaReference(request.resource.data)
        && validLocationSource(request.resource.data)
        && hasNoPublicContactFields(request.resource.data);
      allow update: if isPostOwner()
        && keepsOwnerId()
        && request.resource.data.id == resource.data.id
        && validCloudinaryMediaReference(request.resource.data)
        && validLocationSource(request.resource.data)
        && !publicContactFieldsChanged();
      allow delete: if isPostOwner();
    }

    match /sightings/{sightingId} {
      allow read: if isChatParticipant(resource.data);
      allow create: if signedIn()
        && request.resource.data.id == sightingId
        && request.resource.data.reporterId == uid()
        && request.resource.data.ownerId is string
        && request.resource.data.postId is string
        && request.resource.data.reporterId != request.resource.data.ownerId
        && request.resource.data.ownerId == get(/databases/$(database)/documents/petPosts/$(request.resource.data.postId)).data.ownerId
        && validOptionalMediaReference(request.resource.data)
        && validLocationSource(request.resource.data)
        && preciseSightingLocationIsConsented(request.resource.data);
      allow update, delete: if false;
    }

    match /chatSessions/{chatId} {
      allow get: if isChatParticipant(resource.data);
      allow list: if signedIn()
        && uid() in resource.data.participantIds;
      allow create: if isChatParticipant(request.resource.data)
        && request.resource.data.id == chatId
        && request.resource.data.ownerId is string
        && request.resource.data.reporterId is string
        && request.resource.data.postId is string
        && validParticipantIds(request.resource.data)
        && hasNoChatContactFields(request.resource.data);
      allow update: if isChatParticipant(resource.data)
        && keepsChatParticipants()
        && request.resource.data.id == resource.data.id
        && !chatContactFieldsChanged();
      allow delete: if signedIn() && resource.data.ownerId == uid();

      match /messages/{messageId} {
        allow read: if isChatParticipant(get(/databases/$(database)/documents/chatSessions/$(chatId)).data);
        allow create: if validMessageCreate(chatId, messageId);
        allow update, delete: if false;
      }

      match /contactGrants/{grantId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
